<Window x:Class="XControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XControl — Keyboard &amp; Mouse to Xbox Controller" Width="1060" Height="760" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: real ON/OFF toggle + profile selector -->
        <Grid Grid.Row="0" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ToggleBtn" Grid.Column="0" Width="150" Height="54" FontSize="22" FontWeight="Bold"
                    Click="Toggle_Click" AutomationProperties.Name="Controller on/off switch" Content="OFF"/>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="HeaderDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HeaderStatus" FontSize="16" FontWeight="SemiBold" Text="Controller is OFF"/>
                </StackPanel>
                <TextBlock x:Name="HeaderHint" Opacity="0.75" Margin="20,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ProfileCombo" Width="220" SelectionChanged="ProfileCombo_Changed"
                              AutomationProperties.Name="Active profile"/>
                </StackPanel>
                <CheckBox x:Name="AnyWindowBox" Content="Work in any window" Margin="0,8,0,0" HorizontalAlignment="Right"
                          Checked="AnyWindow_Changed" Unchecked="AnyWindow_Changed" AutomationProperties.Name="Work in any window"
                          ToolTip="OFF: only while a browser or the Xbox app is in front (safer).&#10;ON: mapped keys and mouse buttons are taken over in every window while the controller is ON."/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="12,0,12,12" SelectionChanged="Tabs_Changed">
            <!-- ===== Dashboard ===== -->
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid x:Name="StatusGrid">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            </Grid>
                            <Border x:Name="ErrorBox" Visibility="Collapsed" Margin="0,12,0,0" Padding="10" CornerRadius="4" Background="#33D14343" BorderBrush="#D14343" BorderThickness="1">
                                <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
                            </Border>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Reconnect virtual controller" Margin="0,0,8,8" Padding="12,6" Click="Reconnect_Click"/>
                                <Button Content="Troubleshooting…" Margin="0,0,8,8" Padding="12,6" Click="Troubleshoot_Click"/>
                                <Button Content="Open browser gamepad test" Margin="0,0,8,8" Padding="12,6" Click="OpenGamepadTest_Click"/>
                                <Button Content="Open logs folder" Margin="0,0,8,8" Padding="12,6" Click="OpenLogs_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Virtual controller (live)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Left stick" HorizontalAlignment="Center"/>
                                    <Canvas x:Name="LsCanvas" Width="120" Height="120"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Right stick" HorizontalAlignment="Center"/>
                                    <Canvas x:Name="RsCanvas" Width="120" Height="120"/>
                                </StackPanel>
                                <StackPanel Width="120">
                                    <TextBlock Text="LT"/>
                                    <ProgressBar x:Name="LtBar" Maximum="255" Height="14" Margin="0,2,0,8"/>
                                    <TextBlock Text="RT"/>
                                    <ProgressBar x:Name="RtBar" Maximum="255" Height="14" Margin="0,2,0,8"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Buttons held" Opacity="0.75"/>
                            <TextBlock x:Name="ButtonsText" FontSize="16" FontWeight="SemiBold" Text="—" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <TextBlock x:Name="AxesText" FontFamily="Consolas" Opacity="0.85"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Keybinds ===== -->
            <TabItem Header="Keybinds">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="1. Select a controller action" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Rebind (replace)" Margin="0,0,6,6" Padding="10,5" Click="Rebind_Click"/>
                            <Button Content="Add input" Margin="0,0,6,6" Padding="10,5" Click="AddInput_Click"/>
                            <Button Content="Clear" Margin="0,0,6,6" Padding="10,5" Click="ClearBinding_Click"/>
                            <Button Content="Reset action" Margin="0,0,6,6" Padding="10,5" Click="ResetAction_Click"/>
                            <Button Content="Restore all defaults" Margin="0,0,6,6" Padding="10,5" Click="RestoreDefaults_Click"/>
                        </WrapPanel>
                        <ListView x:Name="ActionList" SelectionMode="Single" MouseDoubleClick="ActionList_DoubleClick"
                                  AutomationProperties.Name="Controller actions and bindings">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Action" Width="150" DisplayMemberBinding="{Binding Label}"/>
                                    <GridViewColumn Header="Bound to" Width="200" DisplayMemberBinding="{Binding Bound}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <DockPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="2. Press the key or mouse button — or click one below" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="WarnText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#D9A400"/>
                        <StackPanel>
                            <Border Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="Gray">
                                <StackPanel x:Name="KeyboardHost"/>
                            </Border>
                            <TextBlock Text="Mouse buttons" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <WrapPanel x:Name="MouseHost"/>
                            <TextBlock Text="Live input preview (press keys in this window)" FontWeight="SemiBold" Margin="0,14,0,4"/>
                            <TextBlock x:Name="PreviewHeld" FontFamily="Consolas" Text="Held: —"/>
                            <TextBlock x:Name="PreviewPad" FontFamily="Consolas" Text="Pad: —" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"
                               Text="Tip: double-click an action to rebind it. Several keys can drive one action (use 'Add input'). Mouse movement is configured on the Mouse tab."/>
                </Grid>
            </TabItem>

            <!-- ===== Mouse ===== -->
            <TabItem Header="Mouse">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MouseSettingsHost" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Preset" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="PresetCombo" Width="220"/>
                                <Button Content="Apply preset" Margin="8,0,0,0" Padding="10,4" Click="ApplyPreset_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Mouse controls" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="TargetCombo" Width="160" SelectionChanged="Target_Changed"/>
                                <CheckBox x:Name="InvertXBox" Content="Invert X" Margin="16,0,0,0" VerticalAlignment="Center" Click="MouseCheck_Click"/>
                                <CheckBox x:Name="InvertYBox" Content="Invert Y" Margin="12,0,0,0" VerticalAlignment="Center" Click="MouseCheck_Click"/>
                                <CheckBox x:Name="CaptureBox" Content="Freeze cursor while active" Margin="12,0,0,0" VerticalAlignment="Center" Click="MouseCheck_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="SliderHost"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Test mode" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                   Text="Move the mouse anywhere. Nothing is sent to the game while the controller is OFF. Dot = resulting right-stick position."/>
                        <Canvas x:Name="TestCanvas" Width="240" Height="240" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TestRaw" FontFamily="Consolas" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TestStick" FontFamily="Consolas"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0"
                                   Text="Games with native mouse support behave differently from games that receive an emulated right stick; the stick is a velocity, so very slow drags stay near centre."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== Profiles ===== -->
            <TabItem Header="Profiles">
                <StackPanel Margin="16">
                    <TextBlock x:Name="ProfileTitle" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProfileDesc" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,12"/>
                    <WrapPanel>
                        <Button Content="New profile" Margin="0,0,8,8" Padding="12,6" Click="NewProfile_Click"/>
                        <Button Content="Duplicate" Margin="0,0,8,8" Padding="12,6" Click="DupProfile_Click"/>
                        <Button Content="Rename" Margin="0,0,8,8" Padding="12,6" Click="RenameProfile_Click"/>
                        <Button Content="Delete" Margin="0,0,8,8" Padding="12,6" Click="DeleteProfile_Click"/>
                        <Button Content="Import…" Margin="0,0,8,8" Padding="12,6" Click="ImportProfile_Click"/>
                        <Button Content="Export…" Margin="0,0,8,8" Padding="12,6" Click="ExportProfile_Click"/>
                        <Button Content="Restore this profile's defaults" Margin="0,0,8,8" Padding="12,6" Click="RestoreDefaults_Click"/>
                    </WrapPanel>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.75"
                               Text="Profiles are stored as JSON in %APPDATA%\XControl\profiles. Each profile has its own bindings and mouse settings. Switch profiles with the selector at the top; game detection is manual."/>
                    <TextBlock x:Name="ProfileWarn" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#D9A400"/>
                </StackPanel>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Global shortcut" FontSize="16" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" AutomationProperties.Name="Toggle shortcut"/>
                            <Button Content="Change…" Margin="8,0,0,0" Padding="12,4" Click="ChangeHotkey_Click"/>
                            <Button Content="Reset" Margin="8,0,0,0" Padding="12,4" Click="ResetHotkey_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="HotkeyNote" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <TextBlock Text="Behaviour" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CheckBox x:Name="OnlyBrowserBox" Content="Only translate input while a browser window is focused (recommended)" Click="Setting_Click" Margin="0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Browser processes" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="BrowsersBox" Width="380" LostFocus="Setting_Click"/>
                        </StackPanel>
                        <CheckBox x:Name="TrayBox" Content="Minimize / close to the system tray" Click="Setting_Click" Margin="0,2"/>
                        <CheckBox x:Name="StartMinBox" Content="Start minimized to the tray" Click="Setting_Click" Margin="0,2"/>
                        <CheckBox x:Name="StartupBox" Content="Launch XControl when I sign in to Windows" Click="Setting_Click" Margin="0,2"/>
                        <CheckBox x:Name="EnableOnLaunchBox" Content="Turn the controller ON when XControl starts" Click="Setting_Click" Margin="0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Update rate" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="RateCombo" Width="110" SelectionChanged="Setting_Click"/>
                            <TextBlock Text="Log level" VerticalAlignment="Center" Margin="24,0,8,0"/>
                            <ComboBox x:Name="LogCombo" Width="110" SelectionChanged="Setting_Click"/>
                        </StackPanel>

                        <TextBlock Text="Driver &amp; diagnostics" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <TextBlock x:Name="DriverInfo" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button Content="Run diagnostics" Margin="0,0,8,8" Padding="12,6" Click="Diagnostics_Click"/>
                            <Button Content="Open settings folder" Margin="0,0,8,8" Padding="12,6" Click="OpenSettingsFolder_Click"/>
                            <Button Content="Reset all settings" Margin="0,0,8,8" Padding="12,6" Click="ResetSettings_Click"/>
                        </WrapPanel>

                        <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <TextBlock x:Name="AboutText" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Rebind overlay -->
        <Grid x:Name="CaptureOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#CC000000" Focusable="True">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24" CornerRadius="8" Background="#FF202020" BorderBrush="#FF3A96DD" BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="CaptureTitle" FontSize="20" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CaptureSub" Foreground="#FFCCCCCC" Margin="0,8,0,16" HorizontalAlignment="Center"/>
                    <Button Content="Cancel" HorizontalAlignment="Center" Padding="20,6" Click="CancelCapture_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
